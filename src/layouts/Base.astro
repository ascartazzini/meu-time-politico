---
import '../styles/tokens.css';
interface Props { title: string; description?: string; badge?: string; wide?: boolean; noindex?: boolean }
const {
  title,
  description = 'Você vota em cinco cargos e decide um de cada vez. Aqui você escala os cinco como um time e descobre se eles jogam juntos — e se têm cadeira pra aprovar alguma coisa.',
  badge,
  noindex = false
} = Astro.props;

// Domínio canônico (o mesmo de astro.config.mjs; o fallback só vale no dev sem `site`).
const SITE = 'https://www.meutimepolitico.com';
const site = Astro.site ?? new URL(SITE);
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL('/og.png', site).toString();
const NOME = 'Meu Time Político 2026';
const GA_ID = 'G-EQMVHHWH9C';

// Dados estruturados: quem somos, o que é o app e pra qual eleição. Ajuda buscador e assistente de IA a citar certo.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite', '@id': `${site.origin}/#site`, url: `${site.origin}/`, name: NOME, inLanguage: 'pt-BR',
      description: 'Escale seus cinco votos de 2026 como um time e veja se eles jogam juntos e se têm cadeira pra aprovar alguma coisa.',
      publisher: { '@id': `${site.origin}/#autor` }
    },
    {
      '@type': 'WebApplication', '@id': `${site.origin}/#app`, name: NOME, url: `${site.origin}/app/`, inLanguage: 'pt-BR',
      applicationCategory: 'Civic tech', operatingSystem: 'Web', browserRequirements: 'Requer JavaScript',
      isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
      description: 'Questionário de 14 pautas e escalação dos cinco cargos das eleições gerais brasileiras de 2026, com placar de coerência, peso e gols contra a partir de votos nominais e bancadas reais.',
      about: { '@type': 'Event', name: 'Eleições gerais no Brasil de 2026', startDate: '2026-10-04', eventStatus: 'https://schema.org/EventScheduled', location: { '@type': 'Country', name: 'Brasil' } },
      author: { '@id': `${site.origin}/#autor` }
    },
    { '@type': 'Person', '@id': `${site.origin}/#autor`, name: 'Artur Scartazzini', url: 'https://arturscartazzini.com', worksFor: { '@type': 'Organization', name: 'Mnova Solutions' } },
    { '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, inLanguage: 'pt-BR', isPartOf: { '@id': `${site.origin}/#site` } }
  ]
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  <script is:inline define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', GA_ID);
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="author" content="Artur Scartazzini" />
  <meta name="application-name" content={NOME} />
  <link rel="canonical" href={canonical} />

  <meta property="og:site_name" content={NOME} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Meu Time Político 2026 — você escala 5. Quantos jogam contra você?" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#080A08" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Chivo+Mono:wght@400;700&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <div class="wrap">
    <header class="top">
      <a class="brand" href="/">MEU TIME <span>POLÍTICO</span><em>2026</em></a>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <nav class="nav"><a href="/">como funciona</a><a href="/app/">escalar</a><a href="/metodo/">método</a></nav>
        <div class="countdown" data-countdown>—</div>
        {badge && <div class="badge beta">{badge}</div>}
      </div>
    </header>
    <slot />
  </div>
  <script>
    import { diasParaOPleito } from '../lib/formato';
    const el = document.querySelector('[data-countdown]');
    if (el) {
      const d = diasParaOPleito();
      el.innerHTML = d > 0 ? `faltam <b>${d}</b> dias pro 1º turno` : 'dia de eleição';
    }
  </script>
</body>
</html>
