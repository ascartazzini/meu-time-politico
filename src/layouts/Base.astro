---
/* Layout escuro do quiz da eleição de 2026 (arquivo em /app/). O site novo usa Social.astro. */
import '../styles/fontes.css';
import '../styles/fontes-fallback.css';
import '../styles/tokens.css';
import Cabeca from '../components/Cabeca.astro';
interface Props { title: string; description?: string; badge?: string; noindex?: boolean }
const { title, description, badge, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <Cabeca title={title} description={description} noindex={noindex} corTema="#080A08" />
</head>
<body>
  <div class="wrap">
    <header class="top">
      <a class="brand" href="/">MEU TIME <span>POLÍTICO</span><em>27–31</em></a>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <nav class="nav"><a href="/">timeline</a><a href="/app/">quiz 2026</a><a href="/metodo/">método</a></nav>
        {badge && <div class="badge beta">{badge}</div>}
      </div>
    </header>
    <slot />
  </div>
</body>
</html>
