---
/* Layout do site: claro, uma coluna, topo com marca e conta. `filtros` entra logo abaixo do topo (fixo junto). */
import '../styles/fontes.css';
import '../styles/fontes-fallback.css';
import '../styles/social.css';
import Cabeca from '../components/Cabeca.astro';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <Cabeca title={title} description={description} noindex={noindex} />
</head>
<body>
  <header class="topo">
    <div class="topo-in">
      <a class="logo" href="/">Meu time <span>político</span></a>
      <div class="conta" id="conta">
        <button class="entrar" type="button" data-entrar hidden>
          <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
          Entrar
        </button>
        <button class="eu" type="button" id="eu" aria-haspopup="true" aria-expanded="false" hidden></button>
      </div>
    </div>
    <div class="menu" id="menu" hidden>
      <a href="/seguir/">Quem eu sigo</a>
      <a href="/semana/">Resumo da semana</a>
      <a href="/metodo/">Como funciona</a>
      <button type="button" id="sair">Sair</button>
    </div>
    <slot name="filtros" />
  </header>

  <main><slot /></main>

  <footer class="rodape">
    Meu Time Político — tech cívica, código aberto, sem vínculo com partido, campanha ou político. Cada item tem link pra fonte.
    <a href="/semana/">Resumo da semana</a> · <a href="/metodo/">Como funciona</a> · <a href="/metodo/#regras">Regras e privacidade</a> · <a href="/app/">Quiz da eleição 2026</a>
  </footer>

  <script>
    import { cliente, entrar, sair, seguidos, trazerTimeDoAparelho } from '../lib/conta';
    import { evento } from '../lib/analytics';
    import { toast } from '../lib/toast';

    const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const bEntrar = document.querySelector<HTMLButtonElement>('[data-entrar]')!;
    const eu = document.getElementById('eu')!, menu = document.getElementById('menu')!;

    document.addEventListener('click', e => {
      const alvo = (e.target as HTMLElement).closest('[data-entrar]');
      if (alvo) { evento('login_inicio', { local: location.pathname }); entrar(); }
    });
    eu.addEventListener('click', () => { menu.hidden = !menu.hidden; eu.setAttribute('aria-expanded', String(!menu.hidden)); });
    document.addEventListener('click', e => { if (!menu.hidden && !(e.target as HTMLElement).closest('#menu, #eu')) { menu.hidden = true; eu.setAttribute('aria-expanded', 'false'); } });
    document.getElementById('sair')!.addEventListener('click', () => sair());

    // Volta do Google: o supabase-js troca o ?code= pela sessão sozinho. No primeiro login, leva o time
    // antigo do aparelho pra conta e, se a pessoa ainda não segue ninguém, manda escolher.
    cliente().auth.onAuthStateChange(async (ev, sessao) => {
      const u = sessao?.user;
      bEntrar.hidden = !!u;
      eu.hidden = !u;
      if (!u) return;
      const nome = String(u.user_metadata.full_name ?? u.user_metadata.name ?? 'Você').split(' ')[0];
      const foto = u.user_metadata.avatar_url as string | undefined;
      eu.innerHTML = `${foto ? `<img src="${esc(foto)}" alt="" referrerpolicy="no-referrer" />` : `<span class="ini">${esc(nome[0])}</span>`}${esc(nome)}`;
      if (ev === 'SIGNED_IN' && new URLSearchParams(location.search).has('code')) {
        history.replaceState(null, '', location.pathname);
        evento('login_ok', {});
        const trazidos = await trazerTimeDoAparelho().catch(() => 0);
        if (trazidos) toast(`Trouxemos os ${trazidos} políticos que você seguia neste aparelho.`);
        if (!(await seguidos()).size && location.pathname !== '/seguir/') location.href = '/seguir/';
      }
    });
    cliente().auth.getSession().then(({ data }) => { if (!data.session) bEntrar.hidden = false; });
  </script>
</body>
</html>
