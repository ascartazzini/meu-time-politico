---
import Social from '../layouts/Social.astro';
import cadastro from '../data/generated/eleitos-2027.json';
---
<Social title="Meu Time Político — o que os eleitos fizeram hoje" description="Tudo o que os políticos eleitos em 2026 fazem, numa timeline: votos, presença, projetos, agenda e o que sai na imprensa, com a fonte de cada coisa. Siga quem você quer cobrar e reaja.">
  <nav class="filtros" slot="filtros" aria-label="Filtrar a timeline">
    <button class="chip" type="button" data-f="todos" aria-pressed="true">Todos</button>
    <button class="chip" type="button" data-f="meus" aria-pressed="false">Quem eu sigo</button>
    <button class="chip" type="button" data-f="presidente" aria-pressed="false">Presidente</button>
    <button class="chip" type="button" data-f="camara" aria-pressed="false">Câmara</button>
    <button class="chip" type="button" data-f="senado" aria-pressed="false">Senado</button>
    <button class="chip" type="button" data-f="agenda" aria-pressed="false">Agenda</button>
    <button class="chip" type="button" data-f="imprensa" aria-pressed="false">Imprensa</button>
  </nav>

  <section class="caixa" id="boasVindas" hidden>
    <h1>O jogo não acaba na urna.</h1>
    <p>Tudo o que os {cadastro.eleitos.length.toLocaleString('pt-BR')} eleitos de 2026 fazem, numa timeline: como votaram, se foram trabalhar,
      com quem se reuniram, o que a imprensa noticiou. <b>Cada item com a fonte.</b></p>
    <p style="margin-top:12px"><button class="btn" type="button" data-entrar>Entrar e escolher quem seguir</button></p>
  </section>

  <input class="busca" id="busca" type="search" placeholder="Filtrar por político: nome, partido ou estado" autocomplete="off" />
  <div id="timeline"></div>

  <script>
    import { montarTimeline, eleitos } from '../lib/timeline';
    import { usuario, seguidos } from '../lib/conta';
    import { evento } from '../lib/analytics';

    const sem = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const busca = document.getElementById('busca') as HTMLInputElement;
    const FILTROS: Record<string, { tipos?: string[]; fontes?: string[] }> = {
      camara: { fontes: ['camara-presenca', 'camara-votacoes', 'camara-proposicoes'] },
      senado: { fontes: ['senado-votacoes', 'senado-discursos'] },
      agenda: { tipos: ['agenda'] },
      imprensa: { tipos: ['noticia'] },
    };
    let filtro = 'todos';

    async function slugs(): Promise<string[] | null> {
      const gente = await eleitos();
      const q = sem(busca.value.trim());
      if (q) return [...gente.values()].filter(e => sem(`${e.nome} ${e.partido} ${e.uf ?? ''}`).includes(q)).map(e => e.slug).slice(0, 200);
      if (filtro === 'meus') return [...(await seguidos())];
      if (filtro === 'presidente') return [...gente.values()].filter(e => e.cargo === 'presidente').map(e => e.slug);
      return null;
    }
    const tl = montarTimeline({
      raiz: document.getElementById('timeline')!, local: 'home', slugs,
      tipos: () => FILTROS[filtro]?.tipos ?? null, fontes: () => FILTROS[filtro]?.fontes ?? null,
      vazio: () => busca.value.trim() ? 'Ninguém com esse nome, ou nada dele ainda.'
        : filtro === 'meus' ? 'Você ainda não segue ninguém. <a href="/seguir/">Escolha quem seguir</a>.' : 'Nada por aqui ainda.',
    });

    function escolher(f: string) {
      filtro = f;
      document.querySelectorAll('.chip').forEach(c => c.setAttribute('aria-pressed', String((c as HTMLElement).dataset.f === f)));
      tl.recarregar();
    }
    document.querySelector('.filtros')!.addEventListener('click', async e => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!b) return;
      if (b.dataset.f === 'meus' && !(await usuario())) { document.querySelector<HTMLButtonElement>('[data-entrar]')?.click(); return; }
      evento('filtro', { filtro: b.dataset.f });
      escolher(b.dataset.f!);
    });
    let t: number | undefined;
    busca.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => tl.recarregar(), 300); });

    // Quem já segue alguém abre direto em "Quem eu sigo"; quem não tem conta vê a caixa de boas-vindas.
    usuario().then(async u => {
      if (!u) { document.getElementById('boasVindas')!.hidden = false; return; }
      const pedido = new URLSearchParams(location.search).get('f');
      if (pedido && document.querySelector(`.chip[data-f="${CSS.escape(pedido)}"]`)) escolher(pedido);
      else if ((await seguidos()).size) escolher('meus');
    });
  </script>
</Social>
