---
/* Uma página por eleito (1.678): estática, boa pra busca, com o feed dele carregado no navegador. */
import Base from '../../layouts/Base.astro';
import '../../styles/time.css';
import cadastro from '../../data/generated/eleitos-2027.json';
import { leve, cargoEmTexto, nomeBonito, paginaOficial, type EleitoBruto, type MandatoBruto } from '../../lib/eleitos';

export function getStaticPaths() {
  return (cadastro.eleitos as EleitoBruto[]).map(e => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props as { e: EleitoBruto };
const l = leve(e);
const cargo = cargoEmTexto(l.cargo, e.uf);
const onde = l.cargo === 'presidente' ? 'Brasil' : e.uf;
const data = (d: string) => new Date(`${d}T12:00:00-03:00`).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
const mandato = (m: MandatoBruto) => `${cargoEmTexto(m.cargo, m.uf)}${m.uf ? ` (${m.uf})` : ''}${m.suplente ? ', suplente em exercício' : ''}: ${data(m.inicio)} a ${data(m.fim)} · eleito em ${m.eleicao}`;
const links = paginaOficial(e);
const iniciais = l.nome.split(' ').filter(w => w.length > 2).slice(0, 2).map(w => w[0]).join('');
---
<Base title={`${l.nome} (${e.partido}${l.cargo === 'presidente' ? '' : `-${e.uf}`}) — ${cargo} · Meu Time Político`}
  description={`O que ${l.nome}, ${cargo.toLowerCase()} ${l.cargo === 'presidente' ? 'do Brasil' : `por ${e.uf}`}, fez no mandato: votos, presença, projetos e o que saiu na imprensa, com a fonte de cada coisa.`}>
  <section class="pol-topo">
    <div class="pol-foto">{e.fotoUrl ? <img src={e.fotoUrl} alt="" width="96" height="128" loading="eager" referrerpolicy="no-referrer" /> : <span>{iniciais}</span>}</div>
    <div>
      <div class="kicker">{cargo} · {onde}</div>
      <h1 class="pol-nome">{l.nome}</h1>
      <p class="pol-sub"><b>{e.partido}</b> · {nomeBonito(e.nome)}</p>
      <div class="pol-acoes" data-politico={JSON.stringify({ slug: l.slug, nome: l.nome, partido: l.partido, uf: l.uf, cargo: l.cargo })}>
        <button type="button" class="cta b-seguir" aria-pressed="false">Seguir</button>
        <button type="button" class="cta ghost b-titular" aria-pressed="false">★ Titular</button>
        <a class="link" href="/time/">ver meu time →</a>
      </div>
    </div>
  </section>

  <section class="bloco">
    <h2 class="bloco-t">Mandatos</h2>
    <ul class="mandatos">{e.mandatos.map(m => <li>{mandato(m)}</li>)}</ul>
    {links.length > 0 && <p class="pol-links">{links.map((x, i) => <>{i > 0 && ' · '}<a href={x.url} target="_blank" rel="noopener">{x.rotulo}</a></>)}</p>}
  </section>

  <section class="bloco">
    <h2 class="bloco-t">O que fez</h2>
    <p class="nota">Registro oficial da Câmara e do Senado (votos, presença, projetos, discursos) e notícias dos grandes veículos que citam {l.nome}.
      Até a posse, registro oficial só existe pra quem já tem mandato.</p>
    <div id="feed"></div>
  </section>

  <footer>
    <b>Meu Time Político</b> — tech cívica, sem vínculo com partido, campanha ou político. Dados do TSE, da Câmara, do Senado e de RSS público
    de imprensa. Achou algo ligado à pessoa errada? <a href="https://github.com/ascartazzini/meu-time-politico/issues" rel="noopener">Avise aqui</a>. <a href="/metodo/">Método</a>.
  </footer>

  <script>
    import { carregarTime, salvarTime, seguir, deixarDeSeguir, alternarTitular, segue, ehTitular, type Escalado } from '../../lib/time';
    import { montarFeed } from '../../lib/feed-ui';
    import { evento } from '../../lib/analytics';

    const caixa = document.querySelector<HTMLElement>('[data-politico]')!;
    const p = JSON.parse(caixa.dataset.politico!) as Omit<Escalado, 'titular'>;
    const bSeguir = caixa.querySelector<HTMLButtonElement>('.b-seguir')!;
    const bTitular = caixa.querySelector<HTMLButtonElement>('.b-titular')!;

    function pintar() {
      const t = carregarTime();
      const s = segue(t, p.slug), ti = ehTitular(t, p.slug);
      bSeguir.setAttribute('aria-pressed', String(s));
      bSeguir.textContent = s ? 'Seguindo' : 'Seguir';
      bTitular.setAttribute('aria-pressed', String(ti));
      bTitular.textContent = ti ? '★ Titular' : '☆ Titular';
    }
    bSeguir.addEventListener('click', () => {
      const t = carregarTime();
      const novo = segue(t, p.slug) ? deixarDeSeguir(t, p.slug) : seguir({ ...t, uf: t.uf ?? (p.uf ?? undefined) }, p);
      salvarTime(novo);
      evento('time_seguir', { cargo: p.cargo, ligado: segue(novo, p.slug), local: 'politico' });
      pintar();
    });
    bTitular.addEventListener('click', () => {
      const t = carregarTime();
      const novo = alternarTitular({ ...t, uf: t.uf ?? (p.uf ?? undefined) }, p);
      salvarTime(novo);
      evento('time_titular', { cargo: p.cargo, ligado: ehTitular(novo, p.slug), local: 'politico' });
      pintar();
    });
    pintar();

    montarFeed({
      raiz: document.getElementById('feed')!, local: 'politico',
      slugs: () => [p.slug], nome: () => p.nome,
      vazio: 'Nada registrado ainda. Os coletores rodam de hora em hora; novatos só ganham registro oficial depois da posse.',
    });
  </script>
</Base>
