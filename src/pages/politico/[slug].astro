---
/* Uma página por eleito (1.678): estática, boa pra busca. Placar e timeline carregam no navegador. */
import Social from '../../layouts/Social.astro';
import cadastro from '../../data/generated/eleitos-2027.json';
import { leve, cargoEmTexto, nomeBonito, paginaOficial, type EleitoBruto, type MandatoBruto } from '../../lib/eleitos';

export function getStaticPaths() {
  return (cadastro.eleitos as EleitoBruto[]).map(e => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props as { e: EleitoBruto };
const l = leve(e);
const cargo = cargoEmTexto(l.cargo, e.uf);
const presidente = l.cargo === 'presidente';
const data = (d: string) => new Date(`${d}T12:00:00-03:00`).toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' }).replace(/ de /g, ' ').replace('.', '');
const mandato = (m: MandatoBruto) => `${cargoEmTexto(m.cargo, m.uf)}${m.uf ? ` (${m.uf})` : ''}${m.suplente ? ', suplente em exercício' : ''}: ${data(m.inicio)} a ${data(m.fim)}`;
const links = paginaOficial(e);
const iniciais = l.nome.split(' ').filter(w => w.length > 2).slice(0, 2).map(w => w[0]).join('') || l.nome[0];
---
<Social title={`${l.nome} (${e.partido}${presidente ? '' : `-${e.uf}`}) — ${cargo} · Meu Time Político`}
  description={`O que ${l.nome}, ${cargo.toLowerCase()} ${presidente ? 'do Brasil' : `por ${e.uf}`}, fez no mandato: votos, presença, projetos, agenda e o que saiu na imprensa, com a fonte de cada coisa.`}>
  <section class="caixa">
    <div class="perfil">
      <span class="ava">{e.fotoUrl ? <img src={e.fotoUrl} alt="" referrerpolicy="no-referrer" /> : iniciais}</span>
      <div class="quem">
        <h1>{l.nome}</h1>
        <small>{e.partido}{presidente ? '' : `-${e.uf}`} · {cargo.toLowerCase()}{l.suplente ? ' · suplente em exercício' : ''}</small>
      </div>
    </div>
    <p style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="btn" type="button" id="seguir" data-slug={l.slug}>Seguir</button>
      {links.map(x => <a class="btn leve" href={x.url} target="_blank" rel="noopener">{x.rotulo}</a>)}
    </p>
    <p>{nomeBonito(e.nome)}. {e.mandatos.map(mandato).join(' · ')}.</p>
    <ul class="placar" id="placar"></ul>
    <p id="placarNota" style="font-size:13px"></p>
  </section>

  <div id="timeline"></div>

  <script>
    import { usuario, seguidos, seguir, entrar, mensagemDeErro } from '../../lib/conta';
    import { montarTimeline } from '../../lib/timeline';
    import { buscarPlacar, linhasDoPlacar, desdeEmTexto } from '../../lib/mandato';
    import { toast } from '../../lib/toast';
    import { evento } from '../../lib/analytics';

    const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const b = document.getElementById('seguir') as HTMLButtonElement;
    const slug = b.dataset.slug!;

    async function pintar() {
      const s = (await seguidos()).has(slug);
      b.textContent = s ? 'Seguindo' : 'Seguir';
      b.classList.toggle('seguindo', s);
    }
    b.addEventListener('click', async () => {
      if (!(await usuario())) return entrar();
      const ligado = !b.classList.contains('seguindo');
      b.disabled = true;
      try { await seguir([slug], ligado); evento('seguir', { local: 'politico', ligado }); await pintar(); }
      catch (err) { toast(mensagemDeErro(err)); }
      b.disabled = false;
    });
    pintar();

    buscarPlacar(slug).then(p => {
      const linhas = linhasDoPlacar(p);
      document.getElementById('placar')!.innerHTML = linhas.map(l =>
        `<li><span>${esc(l.rotulo)}</span><b class="${l.tom ?? ''}">${esc(l.valor)}</b>${l.nota ? `<small>${esc(l.nota)}</small>` : ''}</li>`).join('');
      document.getElementById('placarNota')!.innerHTML = linhas.length
        ? `${esc(desdeEmTexto(p.desde))} Cada número mede uma coisa; não existe nota única. <a href="/metodo/#placar">Como contamos</a>.` : '';
    }).catch(() => {});

    montarTimeline({
      raiz: document.getElementById('timeline')!, local: 'politico', umaPessoa: slug,
      slugs: async () => [slug], tipos: () => null,
      vazio: () => 'Nada registrado ainda. Novatos só ganham registro oficial depois da posse; a imprensa vale desde já.',
    });
  </script>
</Social>
