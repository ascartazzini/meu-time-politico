---
/* Resumo da semana (a newsletter na web). Lê a última edição de `edicoes` no navegador: a edição nova
   aparece sem republicar o site. ?s=AAAA-MM-DD abre uma semana anterior. */
import Social from '../layouts/Social.astro';
import { CONSENTIMENTO } from '../lib/lista-espera';
---
<Social title="Resumo da semana — Meu Time Político" description="As notícias da semana sobre os eleitos, as votações marcadas no Congresso e os marcos que vêm aí. Toda sexta, com a fonte de cada coisa.">
  <section class="caixa">
    <h1>Resumo da semana</h1>
    <p id="quando">Carregando…</p>
  </section>
  <div id="edicao"></div>

  <section class="caixa" id="assinar">
    <h2>Receber por e-mail</h2>
    <p>Toda sexta, o resumo na sua caixa de entrada. Sem spam, e dá pra sair a qualquer hora.</p>
    <form id="formEmail" style="margin-top:10px;display:flex;flex-direction:column;gap:10px">
      <input class="busca" style="margin:0" type="email" name="email" required autocomplete="email" placeholder="voce@exemplo.com" />
      <label style="font-size:13px;color:var(--sub);display:flex;gap:8px;align-items:flex-start"><input type="checkbox" name="ok" required style="margin-top:3px" /> {CONSENTIMENTO}</label>
      <button class="btn" type="submit" style="align-self:flex-start">Quero receber</button>
      <p id="msgEmail" role="status" style="font-size:14px"></p>
    </form>
  </section>

  <script>
    import { SUPABASE_URL, SUPABASE_CHAVE_PUBLICA } from '../lib/supabase';
    import { dataLonga, CASA, type Edicao } from '../lib/edicao';
    import { separarReferencia, explicarEmenta, maiuscula } from '../lib/linguagem';
    import { inscrever } from '../lib/lista-espera';
    import { seguidos } from '../lib/conta';
    import { eleitos } from '../lib/timeline';
    import { evento } from '../lib/analytics';

    const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    // um bloco por assunto, em painel de cor cheia como os posts da timeline
    const painel = (cor: string, rotulo: string, corpo: string) =>
      `<section class="post sem-borda" style="--tipo:${cor}"><div class="peca painel bloco-semana"><span class="rotulo">${rotulo}</span>${corpo}</div></section>`;

    async function abrir() {
      const s = new URLSearchParams(location.search).get('s');
      const filtro = s && /^\d{4}-\d{2}-\d{2}$/.test(s) ? `semana=eq.${s}` : 'order=semana.desc&limit=1';
      const r = await fetch(`${SUPABASE_URL}/rest/v1/edicoes?select=dados&${filtro}`, { headers: { apikey: SUPABASE_CHAVE_PUBLICA } });
      const [linha] = (await r.json()) as { dados: Edicao }[];
      const alvo = document.getElementById('edicao')!;
      if (!linha) { document.getElementById('quando')!.textContent = 'Ainda não tem edição publicada.'; return; }
      const ed = linha.dados;
      document.getElementById('quando')!.innerHTML = `Semana de <b>${esc(dataLonga(ed.semana))}</b>. Tudo com a fonte; toque pra abrir.`;
      const dataCurta = new Date(`${ed.semana}T12:00:00Z`).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
      const noticias = ed.noticias.length ? ed.noticias.map(n => `<article class="post t-noticia">
          <a class="peca capa ${n.imagem ? 'com-foto' : 'sem-foto'}" href="${esc(n.url)}" target="_blank" rel="noopener">
            <span class="capa-topo"><b>${esc(n.fonte)}</b><small>semana de ${esc(dataCurta)}</small></span>
            ${n.imagem ? `<img class="capa-foto" src="${esc(n.imagem)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.capa').classList.replace('com-foto','sem-foto');this.remove()" />` : ''}
            <span class="capa-texto"><strong>${esc(n.titulo)}</strong></span></a>
          ${n.outras.length ? `<p class="tambem">Também na capa de ${n.outras.map(o => `<a href="${esc(o.url)}" target="_blank" rel="noopener">${esc(o.fonte)}</a>`).join(' · ')}</p>` : ''}
          ${n.politicos.length ? `<div class="gente">${n.politicos.map(p => `<a href="/politico/${esc(p.slug)}/">${esc(p.nome)}</a>`).join('')}</div>` : ''}</article>`).join('')
        : '<p class="vazio">Semana fraca de notícia sobre os eleitos nos veículos que acompanhamos.</p>';
      const pauta = ed.pauta.length ? ed.pauta.map(d => `<p class="dia-semana">${esc(dataLonga(d.dia))} · ${CASA[d.casa]}</p>
          ${d.itens.map(i => { const r = separarReferencia(`${i.materia}: ${i.ementa ?? ''}`); return `<a class="item-pauta" href="${esc(i.url)}" target="_blank" rel="noopener">
            <b>${i.ementa ? `${esc(maiuscula(explicarEmenta(i.ementa)))}` : esc(i.materia)}</b><small>${esc(r.ref ?? i.materia)} ↗</small></a>`; }).join('')}`).join('')
        : '<p class="manchete-media">A Câmara e o Senado ainda não publicaram a pauta de votações dos próximos dias. Ela costuma sair na véspera; a timeline mostra quando acontecer.</p>';
      const marcos = ed.marcos.length ? ed.marcos.map(m => `<div class="marco"><p class="numerao"><b>${m.faltam || 'hoje'}</b>${m.faltam ? '<span>dias</span>' : ''}</p>
          <p class="manchete">${esc(m.titulo)}</p><p class="nota">${esc(dataLonga(m.data))} · ${esc(m.detalhe)} (${esc(m.fonte)})</p></div>`).join('')
        : '<p class="manchete-media">Nenhum marco nos próximos 60 dias.</p>';
      const [meus, gente] = await Promise.all([seguidos().catch(() => new Set<string>()), eleitos()]);
      const cobrar = `<p>Siga seus políticos, reaja ao que eles fazem e mande a página deles pra quem votou junto: quanto mais gente olhando, menos dá pra sumir do plenário.</p>
        <p style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><a class="btn" href="${meus.size ? '/?f=meus' : '/seguir/'}">${meus.size ? 'Ver o que meu time fez' : 'Escolher quem seguir'}</a>
        ${[...meus].slice(0, 3).map(s => `<a class="btn leve" href="/politico/${esc(s)}/#cobre">Compartilhar ${esc(gente.get(s)?.nome ?? s)}</a>`).join('')}</p>`;
      alvo.innerHTML = `<h2 class="titulo-semana">As notícias da semana</h2>${noticias}`
        + painel('#1A5FD0', 'Votações pela frente', pauta) + painel('#6B2FA0', 'Marcos que vêm aí', marcos)
        + `<section class="caixa" style="background:var(--marca);border-color:var(--marca)"><h2>Cobre quem você elegeu.</h2>${cobrar}</section>`;
      evento('semana_abrir', { semana: ed.semana });
    }
    abrir().catch(() => { document.getElementById('quando')!.textContent = 'Não deu pra carregar agora. Tenta de novo daqui a pouco.'; });

    document.getElementById('formEmail')!.addEventListener('submit', async e => {
      e.preventDefault();
      const f = e.target as HTMLFormElement, msg = document.getElementById('msgEmail')!;
      const r = await inscrever((f.elements.namedItem('email') as HTMLInputElement).value, undefined, 'semana');
      msg.textContent = r === 'ok' ? 'Pronto. Quando o envio começar, o resumo chega toda sexta.' : r === 'invalido' ? 'Confere o e-mail.' : 'Não deu agora; tenta de novo.';
      if (r === 'ok') { f.querySelector('button')!.disabled = true; evento('lista_espera_inscricao', { local: 'semana' }); }
    });
  </script>
</Social>
