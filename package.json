{
  "name": "meu-time-politico",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build-data && npm run validate-data && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch:tse": "tsx scripts/fetch-tse.ts",
    "fetch:camara": "tsx scripts/fetch-camara.ts",
    "fetch:senado": "tsx scripts/fetch-senado.ts",
    "fetch-data": "npm run fetch:camara && npm run fetch:senado && npm run fetch:tse",
    "fetch:fontes": "tsx scripts/fetch-fontes.ts",
    "build-data": "tsx scripts/build-dataset.ts",
    "validate-data": "tsx scripts/validate-dataset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidencia": "tsx scripts/evidencia-partidos.ts",
    "prova": "tsx scripts/prova/rodar.ts",
    "cadastro": "tsx scripts/cadastro-eleitos.ts",
    "cadastro:carregar": "tsx scripts/carregar-cadastro.ts",
    "editor:partidos": "tsx scripts/evidencia-partidos.ts && tsx scripts/editor-partidos.ts",
    "coletar:camara": "tsx scripts/coletores/camara.ts",
    "coletar:senado": "tsx scripts/coletores/senado.ts",
    "coletar:imprensa": "tsx scripts/coletores/imprensa.ts",
    "coletar": "npm run coletar:camara && npm run coletar:senado && npm run coletar:presidente && npm run coletar:imprensa",
    "coletar:presidente": "tsx scripts/coletores/presidente.ts",
    "links": "tsx scripts/links-eleitos.ts",
    "sugestoes": "tsx scripts/sugestoes.ts",
    "coletar:pauta": "tsx scripts/coletores/pauta.ts",
    "enriquecer": "tsx scripts/coletores/enriquecer.ts",
    "fotos": "tsx scripts/fotos-wiki.ts",
    "newsletter": "tsx scripts/newsletter.ts",
    "og": "tsx scripts/og-politicos.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@supabase/supabase-js": "2.117.3",
    "astro": "^7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "happy-dom": "^20.13.2",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
